# =============================================================================
# WhatsApp Clinic Receptionist - Production Environment Configuration
# =============================================================================

# 1. LLM & Voice Transcription Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
MODEL=openai/gpt-4o-mini
# Optional for Voice Notes Transcription (Telugu, Hindi, English Whisper)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 2. Automated Appointment Reminders (24h and 2h alerts)
ENABLE_REMINDERS=true
REMINDER_CHECK_INTERVAL_MINUTES=15

# 2. WhatsApp Cloud API Configuration (Meta Developer Portal)
# In production, use a Permanent System User token rather than a 24h temp token
WHATSAPP_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_ID=your_meta_phone_number_id
VERIFY_TOKEN=your_webhook_verification_token
# (Optional but Recommended) App Secret for X-Hub-Signature-256 HMAC verification
META_APP_SECRET=your_facebook_app_secret

# 3. Supabase / PostgreSQL Database
# Format: postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# If omitted, defaults to local SQLite clinic.db
DATABASE_URL=

# 4. Google Calendar Live Synchronization (Optional)
# Paste the full Google Cloud Service Account JSON credentials as a single line,
# or set the file path to the service_account.json file
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary
CLINIC_TIMEZONE=Asia/Kolkata

# 5. Server Settings
PORT=8000
DEBUG=false
